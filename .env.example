# Foundry project URL, not the resource's /openai endpoint.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
# Optional overrides when the models live in different Foundry projects:
# RISK_FOUNDRY_PROJECT_ENDPOINT=https://...
# CUSTOMER_FOUNDRY_PROJECT_ENDPOINT=https://...

# Existing deployment names; these are not necessarily catalog model IDs.
RISK_MODEL_DEPLOYMENT=gpt-5.6-sol
CUSTOMER_MODEL_DEPLOYMENT=gpt-5.4-mini

# Azure Identity only: cli (local), managed_identity (Azure), default (credential chain).
AUTH_MODE=cli
# Optional user-assigned managed identity:
# MANAGED_IDENTITY_CLIENT_ID=
# Standard Azure Identity variables (AZURE_CLIENT_ID, AZURE_TENANT_ID,
# AZURE_FEDERATED_TOKEN_FILE) are supported by AUTH_MODE=default.

# SDK default API version is used unless explicitly set.
# API_VERSION=
ALLOW_PREVIEW=false
REQUEST_TIMEOUT=180
MAX_RETRIES=2
LOG_LEVEL=INFO
# Shared settings above accept RISK_ / CUSTOMER_ overrides, e.g. RISK_REQUEST_TIMEOUT.

RISK_HOST=0.0.0.0
RISK_PORT=8001
RISK_PUBLIC_URL=http://localhost:8001
# Optional; enable only if the deployment supports this value.
# RISK_REASONING_EFFORT=high

CUSTOMER_HOST=0.0.0.0
CUSTOMER_PORT=8002
CUSTOMER_PUBLIC_URL=http://localhost:8002
# CUSTOMER_REASONING_EFFORT=low

# URLs used by the A2A clients (can differ from the services' public URLs).
RISK_AGENT_URL=http://localhost:8001
CUSTOMER_AGENT_URL=http://localhost:8002
