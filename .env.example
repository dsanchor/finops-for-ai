# Required OpenAI v1 / Responses API endpoint: APIM or Azure OpenAI directly.
OPENAI_BASE_URL=https://finops4ai.azure-api.net/finopsforai/openai/v1
# Direct alternative: https://finopsforai.openai.azure.com/openai/v1
# Optional per-agent overrides; unset or empty uses the shared URL.
# RISK_OPENAI_BASE_URL=https://finops4ai.azure-api.net/finopsforai/openai/v1
# CUSTOMER_OPENAI_BASE_URL=https://finops4ai.azure-api.net/finopsforai/openai/v1

# Existing deployment names; these are not necessarily catalog model IDs.
RISK_MODEL_DEPLOYMENT=gpt-5.6-sol
CUSTOMER_MODEL_DEPLOYMENT=gpt-5.4-mini

# Azure Identity only: cli (local), managed_identity (Azure), default (credential chain).
AUTH_MODE=cli
# Optional user-assigned managed identity:
# MANAGED_IDENTITY_CLIENT_ID=
# Standard Azure Identity variables (AZURE_CLIENT_ID, AZURE_TENANT_ID,
# AZURE_FEDERATED_TOKEN_FILE) are supported by AUTH_MODE=default.

# OpenAI v1 does not require an api-version query parameter.
REQUEST_TIMEOUT=180
MAX_RETRIES=2
LOG_LEVEL=INFO
# Shared settings above accept RISK_ / CUSTOMER_ overrides, e.g. RISK_REQUEST_TIMEOUT.

RISK_HOST=0.0.0.0
RISK_PORT=8001
RISK_PUBLIC_URL=http://localhost:8001
# Optional; enable only if the deployment supports this value.
# RISK_REASONING_EFFORT=high

CUSTOMER_HOST=0.0.0.0
CUSTOMER_PORT=8002
CUSTOMER_PUBLIC_URL=http://localhost:8002
# CUSTOMER_REASONING_EFFORT=low

# URLs used by the A2A clients (can differ from the services' public URLs).
RISK_AGENT_URL=http://localhost:8001
CUSTOMER_AGENT_URL=http://localhost:8002
# Optional full Agent Card URLs, for example when APIM exposes a custom path.
# If unset or empty, clients discover <AGENT_URL>/.well-known/agent-card.json.
# RISK_AGENT_CARD_URL=https://YOUR-APIM.azure-api.net/risk/agent-card.json
# CUSTOMER_AGENT_CARD_URL=https://YOUR-APIM.azure-api.net/customer-support/agent-card.json
